# --- Local ---
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_API_KEY=ollama
LOCAL_MODEL=llama3.2:3b

# --- Hosted (change these three to switch provider) ---
# Groq console: https://console.groq.com/home → API Keys
HOSTED_BASE_URL=https://api.groq.com/openai/v1
HOSTED_API_KEY=your_key_here
# Free-tier friendly on Groq (Llama model IDs may 404 on some accounts)
HOSTED_MODEL=openai/gpt-oss-20b
